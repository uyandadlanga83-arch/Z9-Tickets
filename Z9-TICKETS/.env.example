# Required: create a Discord bot in the Developer Portal and store its token as a secret.
DISCORD_TOKEN=

# Optional. Set this for fast slash-command sync to one server during setup.
# Leave blank to sync commands globally (global command updates can take longer).
GUILD_ID=

# Optional Discord IDs. Leave blank to configure with /ticket settings later.
TICKET_CATEGORY_ID=
TICKET_PANEL_CHANNEL_ID=
TICKET_LOG_CHANNEL_ID=
TRANSCRIPT_CHANNEL_ID=

# Comma-separated role IDs. Staff roles can work across all ticket categories;
# category-specific entries override the global staff roles for those categories.
STAFF_ROLE_IDS=
ADMIN_ROLE_IDS=
CATEGORY_STAFF_ROLE_IDS_JSON=
# Example:
# CATEGORY_STAFF_ROLE_IDS_JSON={"general":[111111111111111111],"reports":[222222222222222222],"applications":[333333333333333333],"partnerships":[444444444444444444],"other":[555555555555555555]}

# Automation. A zero auto-close timeout disables automatic closing.
INACTIVITY_TIMEOUT_MINUTES=1440
AUTO_CLOSE_TIMEOUT_MINUTES=10080
TICKET_COOLDOWN_SECONDS=60

# Local development paths. On Railway, mount a persistent volume at /data and
# set DATA_DIR=/data. SQLite and HTML transcripts must be stored on that volume.
DATA_DIR=data
DATABASE_PATH=
TRANSCRIPT_DIR=
